rules_version = '2';

// Yomeyo Firestore rules.
//
// Two quite different things live here.
//
// A **mining deck** belongs to exactly one account. Nobody — signed in or not
// — can read or write anyone else's cards.
//
// The **shared library** of premade decks is the opposite: anyone at all can
// read every deck in it, signed in or not, because that is the point — a
// beginner should be able to open the app and start on a real word list
// without making an account first. Writing is limited to the account that
// published a deck, which is decided by the deck's own id: ids begin with the
// publisher's uid, so ownership can be checked from the path without reading
// the deck first. A published deck carries the words only — no scheduling, so
// nothing about anyone's review history is exposed by publishing.
//
// **Public profiles** are readable by everyone for the same reason: they are
// the username and picture attached to a published deck, and a library whose
// authors are invisible until you sign in is a worse library. They hold
// nothing else — never the sign-in identity behind an account.
//
// One account can additionally be the **admin**, who may withdraw anyone's
// deck from the library. The seat is a single document that the first
// account to claim it holds — there is structurally never more than one —
// and it can be released but never taken.
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything is denied unless a rule below allows it.
    match /{document=**} {
      allow read, write: if false;
    }

    // The admin seat. Creating it is claiming it, and only for yourself;
    // it can never be updated, so it can never be taken over — only
    // released by its holder and claimed afresh.
    match /admin/owner {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin/owner)
        && get(/databases/$(database)/documents/admin/owner).data.uid == request.auth.uid;
    }

    match /users/{userId} {
      // The user document holds the deck records and the account's synced
      // progress. The admin may read anyone's and write it — that is the
      // admin panel: fixing a calendar day, granting a missed streak,
      // curating which gacha prizes an account sees.
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isAdmin();

      match /cards/{cardId} {
        allow read: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCard();
      }
    }

    // Public profiles: the username everyone sees and an optional picture.
    // Readable by anyone at all — that is what they are for, and they name
    // the publishers in a library anyone can browse — and only ever written
    // by their own account.
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidProfile();
      allow delete: if isOwner(userId);
    }

    // Username claims, one document per name, so a name can never belong to
    // two accounts: creating the document is taking the name, and a taken
    // name cannot be created again. Releasing your own frees it.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.size() >= 3
        && name.size() <= 20
        && name.matches('[a-z0-9][a-z0-9_-]*');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    function isValidProfile() {
      let p = request.resource.data;
      return p.keys().hasOnly(['name', 'photo'])
        && p.name is string
        // The displayed name must be a claim this account holds, so what a
        // profile shows is always a name nobody else can also show.
        && get(/databases/$(database)/documents/usernames/$(p.name)).data.uid == request.auth.uid
        && (!('photo' in p)
          || (p.photo is string
            && p.photo.size() <= 120000
            && p.photo.matches('data:image/.*')));
    }

    // The shared library of premade decks. The admin may also delete —
    // that is moderation, the reason the seat exists — but never publish
    // or edit under someone else's name.
    match /decks/{deckId} {
      // Anyone may browse and add a deck; only its publisher may change it.
      allow read: if true;
      allow create: if publishedByCaller(deckId) && isValidDeck();
      allow update: if publishedByCaller(deckId) && isValidDeck();
      allow delete: if publishedByCaller(deckId) || isAdmin();

      // The cards, in compressed blocks. Same owner, same rule.
      match /blocks/{blockId} {
        allow read: if true;
        allow create, update: if publishedByCaller(deckId) && isValidBlock();
        allow delete: if publishedByCaller(deckId) || isAdmin();
      }
    }

    // The shared bookshelf: reading material published for everyone, the
    // same shape as decks — a small record, the bytes in blocks beneath.
    // Ownership reads from the id, which begins with the publisher's uid.
    match /books/{bookId} {
      allow read: if true;
      allow create, update: if publishedByCaller(bookId) && isValidBook();
      allow delete: if publishedByCaller(bookId) || isAdmin();

      match /blocks/{blockId} {
        allow read: if true;
        allow create, update: if publishedByCaller(bookId) && isValidBlock();
        allow delete: if publishedByCaller(bookId) || isAdmin();
      }

      // OCR results, one document per page. Any signed-in reader may
      // contribute a page they read, replace a bad one, or clear it —
      // OCR is shared work, and so is the janitoring.
      match /ocr/{page} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['words'])
          && request.resource.data.words is list;
        allow delete: if request.auth != null;
      }
    }
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  // A deck's id starts with the uid of whoever published it, so who may
  // change it is readable from the path — no lookup, and no way to publish
  // under somebody else's name.
  function publishedByCaller(deckId) {
    return request.auth != null && deckId.split('__')[0] == request.auth.uid;
  }

  function isValidDeck() {
    let deck = request.resource.data;
    return deck.keys().hasAll(['name', 'cardCount', 'blockCount', 'ownerUid', 'publishedAt'])
      && deck.ownerUid == request.auth.uid
      && deck.name is string
      && deck.name.size() > 0
      && deck.name.size() <= 120
      && deck.cardCount is int
      && deck.cardCount > 0
      // A cap, so one account cannot fill the library with a huge deck.
      && deck.cardCount <= 100000
      && deck.blockCount is int
      && deck.blockCount > 0
      && deck.blockCount <= 200
      // Written by the server, so the ordering of the library cannot be gamed.
      && deck.publishedAt == request.time;
  }

  function isValidBook() {
    let book = request.resource.data;
    return book.keys().hasAll(['name', 'kind', 'size', 'blockCount', 'ownerUid', 'publishedAt'])
      && book.ownerUid == request.auth.uid
      && book.name is string && book.name.size() > 0 && book.name.size() <= 160
      && book.kind in ['text', 'epub', 'pdf', 'cbz', 'image']
      && book.size is number && book.size <= 130 * 1024 * 1024
      && book.blockCount is number && book.blockCount >= 1 && book.blockCount <= 300;
  }

  function isValidBlock() {
    return request.resource.data.keys().hasOnly(['data'])
      && request.resource.data.data is string
      && request.resource.data.data.size() > 0;
  }

  // Keep obviously malformed writes out of the deck. This is a shape check,
  // not a trust boundary: the owner is already the only writer.
  function isValidCard() {
    let card = request.resource.data;
    return card.keys().hasAll(['id', 'term', 'reading', 'updatedAt', 'due', 'state'])
      && card.id is string
      && card.id.size() > 0
      && card.id.size() <= 128
      && card.term is string
      && card.term.size() > 0
      && card.term.size() <= 200
      && card.reading is string
      && card.reading.size() <= 200
      && card.updatedAt is number
      && card.due is number
      && card.state in ['new', 'learning', 'review', 'relearning']
      // Written by the server on every sync; clients cannot forge it.
      && card.syncedAt == request.time;
  }
}
