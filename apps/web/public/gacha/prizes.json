  "cutscenes": {
    "green": {
      "title": "For an amazing reason",
      "lines": [
        "chichan look",
        "why are you green....",
        "for an amazing reason",
        "that's not a reason"
      ]
    },
    "hungry": {
      "title": "Rations",
      "lines": [
        "chichan. i'm hungry",
        "you ate the last one",
        "that was ages ago",
        "(smack) die faggot",
        "...food?"
      ]
    },
    "stairs": {
      "title": "Then we live here now",
      "lines": [
        "How far up does up go",
        "All the way",
        "Then we live here now",
        "(something takes the stairs)",
        "...it used the handrail"
      ]
    },
    "parachute": {
      "title": "Special delivery, eventually",
      "lines": [
        "It's taking its time",
        "It has a parachute",
        "I want a parachute",
        "You'd eat it",
        "...only a bit",
        "(it lands exactly between them)"
      ]
    },
    "campfire": {
      "title": "The fire was hungrier",
      "lines": [
        "Last ration. Cook it carefully",
        "I'm the careful one",
        "You are not",
        "(the fire eats it)",
        "the fire was hungrier",
        "look — it's sorry"
      ]
    },
    "hail": {
      "title": "Adverse weather",
      "lines": [
        "run",
        "which way",
        "...that one was polite"
      ]
    },
    "order": {
      "title": "Table service",
      "lines": [
        "is anyone here",
        "nobody's been here for years",
        "then who's that",
        "don't ask"
      ]
    },
    "soak": {
      "title": "Something in the water",
      "lines": [
        "this was a good idea",
        "something touched my foot",
        "wasn't me",
        "i know. that's the problem"
      ]
    },
    "tank": {
      "title": "Feeding time",
      "lines": [
        "they're still alive",
        "somebody's feeding them",
        "can we eat them",
        "no—",
        "(the tank disagrees)"
      ]
    },
    "lesson": {
      "title": "School is in session",
      "lines": [
        "Today: this one. It reads yu",
        "Chi-chan",
        "that's a fish",
        "It's a letter",
        "a tasty fish...",
        "(drooling)",
        "Please don't eat the alphabet",
        "the fish is glowing"
      ]
    },
    "fisher": {
      "title": "Patience worked",
      "lines": [
        "I'm fishing",
        "You don't have a rod",
        "I have patience",
        "You have neither",
        "(something bites)",
        "PATIENCE WORKED"
      ]
    },
    "books": {
      "title": "Tripped on human history",
      "lines": [
        "A whole floor of books survived",
        "I'm reading them in order",
        "do they taste different?",
        "(she is not watching the floor)",
        "(the to-read pile fights back)",
        "...the floor wanted them more",
        "You tripped on human history",
        "history is glowing"
      ]
    }
  },
